#!/bin/bash

# Exit immediately if a command exits with a non-zero status.
set -e
# Uncomment the following line for debugging: display commands as they are executed.
# set -x

# --- Paths and Configurations ---
# Path to the bare Git repository on the server
REPO_DIR="/root/.repositories.git/taskbot.git"
# Path to the MAIN directory where the code for EACH branch will be checked out
# Each branch will get its own subdirectory here (e.g., /root/taskbot/main, /root/taskbot/development)
MAIN_TARGET_DIR="/root/taskbot"
# Path to the main Docker Compose file (production/staging) - THIS MIGHT NEED ADJUSTMENT based on new structure
# If your docker-compose.yml is inside the main branch's target dir, you'll need to adjust its path later.
# For now, we'll assume docker-compose might be managed separately or referenced differently.
# DOCKER_COMPOSE_FILE_PROD="$MAIN_TARGET_DIR/main/docker-compose.yml" # Example adjustment
# DOCKER_COMPOSE_FILE_DEV="$MAIN_TARGET_DIR/development/docker-compose.yml" # Example adjustment

# --- Helper Functions ---
# Function to log messages to stdout (which will be displayed during git push)
log_message() {
    echo ">>> $1"
}

# Function to display an error message and exit the script
error_exit() {
    log_message "ERROR: $1"
    log_message "Deployment failed. Please check the output above for details."
    exit 1
}

# --- Processing the Push ---
# Read push information from standard input
read oldrev newrev refname

# Extract the branch name from refname
BRANCH=$(echo "$refname" | sed 's/refs\/heads\///')

log_message "--- Deploy triggered for branch: $BRANCH ---"

# Define the specific WORK_TREE for the current branch
# This is the core change: each branch gets its own subdirectory
CURRENT_WORK_TREE="${MAIN_TARGET_DIR}/${BRANCH}"

# --- Execution Logic Based on Branch Name ---

# Ensure the main target directory exists
mkdir -p "$MAIN_TARGET_DIR" || error_exit "Failed to create main target directory: $MAIN_TARGET_DIR"

# --- Logic for Development Branch ---
if [ "$BRANCH" = "development" ]; then
    log_message "--- Development branch detected ---"
    log_message "Checking out development code to $CURRENT_WORK_TREE..."

    # Ensure the specific WORK_TREE directory for this branch exists and is clean
    rm -rf "$CURRENT_WORK_TREE" # Remove previous checkout if it exists
    mkdir -p "$CURRENT_WORK_TREE" || error_exit "Failed to create target directory for development: $CURRENT_WORK_TREE"

    # Update the code for the development branch using the specific WORK_TREE
    git --work-tree="$CURRENT_WORK_TREE" --git-dir="$REPO_DIR" checkout -f development || error_exit "Failed to checkout development branch into $CURRENT_WORK_TREE."
    
    # Change directory to the specific work tree for this branch to run docker-compose
    cd "$CURRENT_WORK_TREE" || error_exit "Could not change directory to $CURRENT_WORK_TREE"

    log_message "Development code updated in $CURRENT_WORK_TREE."
    log_message "Starting development environment with Docker Compose..."

    # --- Docker Compose for Development ---
    # IMPORTANT: You MUST adjust the path to your docker-compose file here.
    # If your docker-compose.yml is located inside the 'development' folder:
    DOCKER_COMPOSE_FILE_DEV="$CURRENT_WORK_TREE/docker-compose.yml"
    # If it's located elsewhere, specify that full path.

    if [ -f "$DOCKER_COMPOSE_FILE_DEV" ]; then
        # Start the development environment using Docker Compose
        # --build : Ensures images are rebuilt if Dockerfile has changed
        # -d : Runs containers in detached mode (background)
        docker-compose -f "$DOCKER_COMPOSE_FILE_DEV" down -v || true
        docker-compose -f "$DOCKER_COMPOSE_FILE_DEV" up -d --build || error_exit "Docker Compose for development failed to start."
        log_message "Development environment with Docker Compose is up and running."
    else
        error_exit "Docker Compose file for development ($DOCKER_COMPOSE_FILE_DEV) not found. Cannot start development environment."
    fi

    log_message "--- Development deployment finished successfully ---"
    exit 0
fi

# --- Logic for Main (Production) Branch ---
if [ "$BRANCH" = "main" ]; then
    log_message "--- Main branch detected (Production Deploy) ---"
    log_message "Checking out production code to $CURRENT_WORK_TREE..."

    # Ensure the specific WORK_TREE directory for this branch exists and is clean
    rm -rf "$CURRENT_WORK_TREE" # Remove previous checkout if it exists
    mkdir -p "$CURRENT_WORK_TREE" || error_exit "Failed to create target directory for main: $CURRENT_WORK_TREE"

    # Update the code for the main branch using the specific WORK_TREE
    git --work-tree="$CURRENT_WORK_TREE" --git-dir="$REPO_DIR" checkout -f main || error_exit "Failed to checkout main branch into $CURRENT_WORK_TREE."

    # Change directory to the specific work tree for this branch to run docker-compose
    cd "$CURRENT_WORK_TREE" || error_exit "Could not change directory to $CURRENT_WORK_TREE"

    log_message "Production code updated in $CURRENT_WORK_TREE."
    log_message "Using docker-compose for production deployment..."

    # --- Docker Compose for Production ---
    # IMPORTANT: You MUST adjust the path to your docker-compose file here.
    # If your docker-compose.yml is located inside the 'main' folder:
    DOCKER_COMPOSE_FILE_PROD="$CURRENT_WORK_TREE/docker-compose.yml"
    # If it's located elsewhere, specify that full path.

    if [ -f "$DOCKER_COMPOSE_FILE_PROD" ]; then
        # Start the production environment using Docker Compose
        # --build : Ensures images are rebuilt if Dockerfile has changed 
        # -d : Runs containers in detached mode (background)
        docker-compose -f "$DOCKER_COMPOSE_FILE_PROD" down -v || true
        docker-compose -f "$DOCKER_COMPOSE_FILE_PROD" up -d --build || error_exit "Docker Compose for production failed to start."
        log_message "Production environment with Docker Compose is up and running."
    else
        error_exit "Docker Compose file for production ($DOCKER_COMPOSE_FILE_PROD) not found. Cannot deploy production."
    fi

    log_message "--- Production deployment finished successfully ---"
    exit 0
fi

# If the pushed branch is neither main nor development
log_message "--- No deployment rule defined for branch: $BRANCH. No action taken. ---"
exit 0
